<!DOCTYPE html>
<html>
<head>
  <title>paylane — payments portal</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 900px; margin: 2rem auto; color: #222; }
    h1 { color: #0D2C54; }
    table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
    th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #ddd; font-size: 0.9rem; }
    th { background: #0D2C54; color: #fff; }
    form { background: #F4ECD8; padding: 1rem; border-radius: 6px; margin: 1rem 0; }
    label { display: inline-block; width: 140px; }
    .err { color: #A23B3B; font-weight: bold; }
    .status-SETTLED { color: #3A7D44; font-weight: bold; }
    .status-ACCEPTED { color: #C7A052; font-weight: bold; }
    .status-FAILED { color: #A23B3B; font-weight: bold; }
    nav a { margin-right: 1rem; }
  </style>
</head>
<body>
  <h1>paylane</h1>
  <nav><a href="/">Payments</a><a href="/accounts">Accounts</a></nav>
  <% if (error) { %><p class="err">Upstream error: <%= error %></p><% } %>

  <form method="POST" action="/pay">
    <h3>Submit a payment</h3>
    <p><label>Mandate</label>
      <select name="mandate_ref">
        <% mandates.forEach(m => { %>
          <option value="<%= m.mandate_ref %>"><%= m.mandate_ref %> — <%= m.payer_ref %> → <%= m.payee_ref %> (cap ₹<%= (m.max_amount_paise/100).toFixed(2) %>)</option>
        <% }) %>
      </select></p>
    <p><label>Amount (₹)</label><input name="amount_rupees" type="number" step="0.01" value="100.00" required></p>
    <p><label>Idempotency key</label><input name="idempotency_key" placeholder="optional"></p>
    <p><button type="submit">Submit payment</button></p>
  </form>

  <h3>Recent payments</h3>
  <table>
    <tr><th>Reference</th><th>Payer</th><th>Payee</th><th>Amount</th><th>Status</th></tr>
    <% payments.forEach(p => { %>
      <tr>
        <td><%= p.payment_ref %></td>
        <td><%= p.payer_ref %></td>
        <td><%= p.payee_ref %></td>
        <td>₹<%= (p.amount_paise/100).toFixed(2) %></td>
        <td class="status-<%= p.status %>"><%= p.status %></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
